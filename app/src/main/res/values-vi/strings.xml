    <string name="bit_perfect_mode_usb_android">DAC USB</string>
    <string name="bit_perfect_mode_usb_android_subtitle">Android 14 mở DAC ở tần số và độ sâu bit của từng bản nhạc, không trộn và không lấy mẫu lại.</string>
    <string name="bit_perfect_requires_android_14">Yêu cầu Android 14 trở lên</string>
    <string name="bit_perfect_mode_dap_exclusive">DAC tích hợp (AAudio độc quyền)</string>
    <string name="bit_perfect_mode_dap_exclusive_subtitle">Dành cho máy nghe nhạc có DAC riêng. Mở đầu ra tai nghe hoặc line độc quyền ở tần số của từng bản nhạc. Không phải thiết bị nào cũng cho phép chế độ độc quyền.</string>
    <string name="bit_perfect_requires_android_8_1">Yêu cầu Android 8.1 trở lên</string>
    <string name="bit_perfect_mode_usb_direct">DAC USB (trình điều khiển trực tiếp)</string>
    <string name="bit_perfect_mode_usb_direct_subtitle">bit tự điều khiển DAC trên mọi phiên bản Android và đặt âm lượng ngay trên DAC. Cần quyền USB. Có thể to hơn nhiều so với đầu ra thông thường.</string>
    <string name="dac_volume">Âm lượng DAC</string>
    <string name="dac_volume_subtitle">Đặt trên chính DAC; nhạc không bị co giãn mức tín hiệu</string>
