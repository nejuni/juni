    <string name="bit_perfect_mode_usb_android">DAC USB</string>
    <string name="bit_perfect_mode_usb_android_subtitle">Android 14 membuka DAC pada rate dan kedalaman bit masing-masing trek, tanpa mixing atau resampling.</string>
    <string name="bit_perfect_requires_android_14">Memerlukan Android 14 atau lebih baru</string>
    <string name="bit_perfect_mode_dap_exclusive">DAC bawaan (AAudio eksklusif)</string>
    <string name="bit_perfect_mode_dap_exclusive_subtitle">Untuk pemutar musik dengan DAC sendiri. Membuka output headphone atau line secara eksklusif pada rate masing-masing trek. Tidak semua perangkat memberikan mode eksklusif.</string>
    <string name="bit_perfect_requires_android_8_1">Memerlukan Android 8.1 atau lebih baru</string>
    <string name="bit_perfect_mode_usb_direct">DAC USB (driver langsung)</string>
    <string name="bit_perfect_mode_usb_direct_subtitle">bit mengendalikan DAC sendiri, di versi Android apa pun, dan mengatur volumenya di DAC. Meminta izin USB. Bisa jauh lebih keras daripada output normal.</string>
    <string name="dac_volume">Volume DAC</string>
    <string name="dac_volume_subtitle">Diatur di DAC itu sendiri; musik tidak diskalakan</string>
    <string name="usb_allow_fixed_volume">Izinkan DAC tanpa kontrol volume</string>
    <string name="usb_allow_fixed_volume_subtitle">Jika tidak, DAC seperti itu memutar lewat output normal</string>
    <string name="usb_allow_fixed_volume_confirm_title">Putar pada skala penuh?</string>
    <string name="usb_allow_fixed_volume_confirm_message">bit tidak bisa mengatur volume DAC jenis ini, jadi DAC memutar pada skala penuh dan hanya kenopnya sendiri, jika ada, yang mengatur kenyaringan. Ini bisa sangat keras dan berbahaya dengan headphone sensitif.</string>
    <string name="convert_for_limited_dac">Konversi untuk DAC spesifikasi rendah</string>
    <string name="convert_for_limited_dac_subtitle">Mengonversi trek di atas batas DAC Anda ke format tertingginya. Trek mungkin lebih lama dimulai dan tidak akan bit-perfect terhadap aslinya.</string>
