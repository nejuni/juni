    <string name="bit_perfect_output">Saída bit-perfect</string>
    <string name="bit_perfect_bypassed_footer">A saída bit-perfect está pronta, então os ajustes esmaecidos são ignorados e as versões Dolby Atmos não são solicitadas. Eles voltam a funcionar quando o DAC é desconectado ou o modo é desativado.</string>
    <string name="bit_perfect_sheet_warning">Envia a faixa ao DAC sem alterações. O equalizador, a normalização de volume, o fade cruzado, o Automix, a velocidade de reprodução e o volume do bit são ignorados.</string>
    <string name="bit_perfect_mode_off_subtitle">O áudio passa pelo mixer do Android e pelos efeitos do bit.</string>
    <string name="bit_perfect_mode_usb_android">DAC USB</string>
    <string name="bit_perfect_mode_usb_android_subtitle">O Android 14 abre o DAC na taxa e na profundidade de bits de cada faixa, sem mixagem nem reamostragem.</string>
    <string name="bit_perfect_requires_android_14">Requer Android 14 ou posterior</string>
    <string name="bit_perfect_mode_dap_exclusive">DAC integrado (AAudio exclusivo)</string>
    <string name="bit_perfect_mode_dap_exclusive_subtitle">Para players de música com DAC próprio. Abre a saída de fones ou de linha com exclusividade na taxa de cada faixa. Nem todo dispositivo concede o modo exclusivo.</string>
    <string name="bit_perfect_requires_android_8_1">Requer Android 8.1 ou posterior</string>
    <string name="bit_perfect_mode_usb_direct">DAC USB (driver direto)</string>
    <string name="bit_perfect_mode_usb_direct_subtitle">O bit controla o DAC diretamente, em qualquer versão do Android, e define o volume no próprio DAC. Pede permissão de USB. Pode ser bem mais alto que a saída normal.</string>
    <string name="dac_volume">Volume do DAC</string>
    <string name="dac_volume_subtitle">Definido no próprio DAC; a música não é escalonada</string>
    <string name="usb_allow_fixed_volume">Permitir DACs sem controle de volume</string>
    <string name="usb_allow_fixed_volume_subtitle">Caso contrário, esse DAC toca pela saída normal</string>
    <string name="usb_allow_fixed_volume_confirm_title">Tocar em escala total?</string>
    <string name="usb_allow_fixed_volume_confirm_message">O bit não consegue definir o volume desse tipo de DAC, então ele toca em escala total e só o botão do próprio DAC, se houver, controla o nível. Isso pode ser perigosamente alto com fones sensíveis.</string>
    <string name="convert_for_limited_dac">Converter para DACs mais limitados</string>
    <string name="convert_for_limited_dac_subtitle">Converte faixas acima do limite do seu DAC para o formato mais alto dele. As faixas podem demorar mais para começar e não serão bit-perfect em relação ao original.</string>
    <string name="bit_perfect_confirm_title">Ativar a saída bit-perfect?</string>
    <string name="bit_perfect_confirm_message">O DAC recebe a música em escala total, e os botões de volume do telefone podem parar de funcionar. Abaixe o DAC ou o amplificador antes de tocar.</string>
