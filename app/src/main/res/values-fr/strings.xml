    <string name="bit_perfect_output">Sortie bit-perfect</string>
    <string name="bit_perfect_bypassed_footer">La sortie bit-perfect est prête : les réglages grisés sont donc contournés et les versions Dolby Atmos ne sont pas demandées. Ils fonctionnent à nouveau quand le DAC est débranché ou que le mode est désactivé.</string>
    <string name="bit_perfect_sheet_warning">Envoie le morceau au DAC sans modification. L\'égaliseur, la normalisation du volume, le fondu enchaîné, Automix, la vitesse de lecture et le volume de bit sont contournés.</string>
    <string name="bit_perfect_mode_off_subtitle">Le son passe par le mixeur d\'Android et les effets de bit.</string>
    <string name="bit_perfect_mode_usb_android">DAC USB</string>
    <string name="bit_perfect_mode_usb_android_subtitle">Android 14 ouvre le DAC à la fréquence et à la profondeur de bits de chaque morceau, sans mixage ni rééchantillonnage.</string>
    <string name="bit_perfect_requires_android_14">Nécessite Android 14 ou version ultérieure</string>
    <string name="bit_perfect_mode_dap_exclusive">DAC intégré (AAudio exclusif)</string>
    <string name="bit_perfect_mode_dap_exclusive_subtitle">Pour les lecteurs de musique dotés de leur propre DAC. Ouvre la sortie casque ou ligne en exclusivité à la fréquence de chaque morceau. Tous les appareils n\'accordent pas le mode exclusif.</string>
    <string name="bit_perfect_requires_android_8_1">Nécessite Android 8.1 ou version ultérieure</string>
    <string name="bit_perfect_mode_usb_direct">DAC USB (pilote direct)</string>
    <string name="bit_perfect_mode_usb_direct_subtitle">bit pilote lui-même le DAC, sur toute version d\'Android, et règle le volume sur le DAC. Demande l\'autorisation USB. Le son peut être bien plus fort qu\'avec la sortie normale.</string>
    <string name="dac_volume">Volume du DAC</string>
    <string name="dac_volume_subtitle">Réglé sur le DAC lui-même ; la musique n\'est pas mise à l\'échelle</string>
    <string name="usb_allow_fixed_volume">Autoriser les DAC sans contrôle du volume</string>
    <string name="usb_allow_fixed_volume_subtitle">Sinon, ce DAC passe par la sortie normale</string>
    <string name="usb_allow_fixed_volume_confirm_title">Lire à pleine échelle ?</string>
    <string name="usb_allow_fixed_volume_confirm_message">bit ne peut pas régler le volume de ce type de DAC : il joue donc à pleine échelle et seul son propre bouton, s\'il en a un, contrôle le niveau. Cela peut être dangereusement fort avec un casque sensible.</string>
    <string name="convert_for_limited_dac">Convertir pour les DAC plus limités</string>
    <string name="convert_for_limited_dac_subtitle">Convertit les morceaux au-delà de la limite de votre DAC vers son format le plus élevé. Ils peuvent mettre plus de temps à démarrer et ne seront pas bit-perfect par rapport à l\'original.</string>
    <string name="bit_perfect_confirm_title">Activer la sortie bit-perfect ?</string>
    <string name="bit_perfect_confirm_message">Le DAC reçoit la musique à pleine échelle et les boutons de volume du téléphone peuvent cesser de fonctionner. Baissez le DAC ou l\'amplificateur avant de lancer la lecture.</string>
