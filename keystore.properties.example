# Release signing — copy this file to keystore.properties and fill it in.
#
# keystore.properties is gitignored, as is every *.jks / *.keystore file. The
# same key signs every APK this project ever builds — arm64-v8a, armeabi-v7a,
# universal and future architectures — so an installed copy can always be
# updated in place. Losing the key or its passwords means every future build
# needs a new application ID (or a manual uninstall that wipes the library).
#
# Create it once, from the project root. keytool is part of the JDK:
#
#   keytool -genkeypair -v -keystore juni-release.jks -alias juni \
#       -keyalg RSA -keysize 4096 -validity 10000 \
#       -dname "CN=Sharavan Kumar, OU=Android, O=Juni, L=Unknown, ST=Unknown, C=IN"
#
# It asks for the store password and the key password; use the same strong
# password for both, or remember both. Back up juni-release.jks and the
# passwords somewhere safe (password manager + offline copy).
#
# For GitHub Actions, the workflow restores the same key from repository
# secrets. Base64-encode the keystore without line breaks:
#
#   Linux:     base64 -w0 juni-release.jks > juni-release.jks.b64
#   macOS:     base64 -i juni-release.jks -o juni-release.jks.b64
#   PowerShell:[Convert]::ToBase64String([IO.File]::ReadAllBytes("juni-release.jks")) |
#                  Set-Content juni-release.jks.b64
#
# Then add these repository secrets (Settings → Secrets and variables → Actions):
#   RELEASE_KEYSTORE_BASE64  = contents of juni-release.jks.b64
#   RELEASE_STORE_PASSWORD   = the store password
#   RELEASE_KEY_ALIAS        = juni
#   RELEASE_KEY_PASSWORD     = the key password
#
# Android Studio can generate the same file (Build → Generate Signed Bundle /
# APK → Create new), but the command above is reproducible and gives a longer
# validity by default.

storeFile=juni-release.jks
storePassword=
keyAlias=juni
keyPassword=
